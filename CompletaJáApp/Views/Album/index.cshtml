@model IEnumerable<CompletaJaApp.Models.Album>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meus Álbuns - CompletaJá</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/albuns.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>

    <div class="app-container">
        <header class="top-header">
            <div class="user-info">
                <img src="@ViewBag.FotoUsuario" alt="Perfil" class="avatar-top" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                <span class="logo-text">CompletaJá</span>
            </div>
            <div class="header-actions">
                <i class="fa-regular fa-bell icon-bell"></i>
            </div>
        </header>

        <main class="content album-content">
            <div class="album-header">
                <h2>Meus Álbuns</h2>
                <p>Gerencie suas coleções ativas</p>
            </div>

            <a href="/Album/Add" class="btn-add-album" style="text-decoration:none;">
                <i class="fa-solid fa-circle-plus"></i> Adicionar Álbum
            </a>

            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Buscar coleções...">
            </div>

            <div class="album-list">
                @if (!Model.Any())
                {
                    <div style="text-align: center; color: #6b7280; margin-top: 30px;">
                        <i class="fa-solid fa-folder-open" style="font-size: 3rem; margin-bottom: 10px; color: #d1d5db;"></i>
                        <p>Nenhum álbum cadastrado ainda.<br>Clique em "Adicionar Álbum" para começar!</p>
                    </div>
                }
                else
                {
                    @foreach (var album in Model)
                    {
                        <div class="album-card">
                            <img src="@album.CapaUrl" class="album-img" alt="@album.Nome">
                            <div class="album-details">
                                <span class="badge badge-popular">SISTEMA</span>
                                <h3>@album.Nome</h3>
                                <div class="album-count">
                                    <i class="fa-regular fa-clone"></i> Total de @album.QuantidadeTotalFigurinhas figurinhas
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </main>

        <nav class="bottom-nav">
            <a href="/Home" class="nav-item">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <a href="/Album" class="nav-item active">
                <i class="fa-solid fa-book-open"></i>
                <span>Álbuns</span>
            </a>
            <a href="/Locais" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i>
                <span>Locais</span>
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-comments"></i>
                <span>Trocas</span>
            </a>
        </nav>
    </div>
    
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>

</body>
</html>