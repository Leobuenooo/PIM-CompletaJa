@model IEnumerable<CompletaJaApp.Models.Mensagem>
@{
    ViewData["Title"] = "Chat";
    var outroUsuario = ViewBag.OutroUsuario as CompletaJaApp.Models.Usuario;
    int meuId = ViewBag.MeuId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <style>
        /* 1. Container Principal da Página */
        .chat-page-main {
            padding: 0 !important;
            margin: 0 !important;
            height: calc(100vh - 135px); 
            width: 100%;
            display: flex;
            flex-direction: column;
            background-color: #ffffff;
        }

        /* 2. Janela de Conversa: OCUPANDO 100% DO ESPAÇO */
        .chat-content {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            max-width: 100%;
            margin: 0; 
            background: #ffffff;
            border-radius: 0;
            box-shadow: none;
        }

        /* 3. Cabeçalho Fixo no Topo */
        .chat-header {
            display: flex;
            align-items: center;
            padding: 16px 25px;
            background: #ffffff;
            border-bottom: 1px solid #cbd5e1;
            gap: 15px;
            flex-shrink: 0;
        }
        
        .btn-back { color: #64748b; font-size: 1.2rem; text-decoration: none; transition: color 0.2s; }
        .btn-back:hover { color: #1D58E6; }
        .chat-avatar { width: 45px; height: 45px; border-radius: 50%; object-fit: cover; }
        .chat-user-info { display: flex; flex-direction: column; gap: 2px; }
        .chat-user-info h3 { margin: 0; font-size: 1.1rem; color: #0f172a; font-weight: 700; }
        .chat-user-info span { font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 6px; }

        /* 4. Área de Rolagem das Mensagens */
        .chat-messages {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background-color: #f8fafc;
        }

        /* 5. Bolhas de Mensagem */
        .msg-bubble {
            max-width: 70%;
            padding: 12px 16px;
            border-radius: 18px;
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        
        .msg-bubble.mine {
            align-self: flex-end;
            background: #1D58E6;
            color: #ffffff;
            border-bottom-right-radius: 4px;
        }
        
        .msg-bubble.other {
            align-self: flex-start;
            background: #ffffff;
            color: #334155;
            border-bottom-left-radius: 4px;
            border: 1px solid #e2e8f0;
        }

        .msg-text { font-size: 0.95rem; line-height: 1.4; word-wrap: break-word; }
        .msg-bubble.mine .msg-time { align-self: flex-end; font-size: 0.7rem; color: #bfdbfe; }
        .msg-bubble.other .msg-time { align-self: flex-end; font-size: 0.7rem; color: #94a3b8; }

        /* Estado Vazio */
        .chat-empty {
            text-align: center; color: #64748b; margin: auto; font-size: 0.95rem;
            background: #ffffff; padding: 12px 24px; border-radius: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02); border: 1px solid #e2e8f0;
        }

        /* 6. Barra de Input Fixa na Base */
        .chat-input-area {
            display: flex;
            padding: 16px 25px;
            background: #ffffff;
            border-top: 1px solid #cbd5e1;
            gap: 12px;
            align-items: center;
            flex-shrink: 0;
        }
        .chat-input-area input {
            flex: 1;
            padding: 14px 20px;
            border: 1px solid #cbd5e1;
            border-radius: 30px;
            font-size: 0.95rem;
            outline: none;
            transition: 0.2s;
            background: #f8fafc;
        }
        .chat-input-area input:focus { border-color: #1D58E6; background: #ffffff; }
        
        .btn-send {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #1D58E6;
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.2s;
            flex-shrink: 0;
        }
        .btn-send:hover { background: #1545b8; transform: scale(1.05); }

        /* ======== MOBILE ======== */
        /* Uso do duplo arroba e quebra de linhas para não bugar o Razor */
        @@media (max-width: 768px) {
            .chat-page-main { 
                height: calc(100vh - 130px); 
            }
            .msg-bubble { 
                max-width: 90%; 
            }
            .chat-header, .chat-input-area { 
                padding: 16px 15px; 
            }
        }
    </style>
}


<main class="content chat-page-main">
    <div class="chat-content">
        
        <div class="chat-header">
            <img src="@outroUsuario.FotoUrl" class="chat-avatar" alt="@outroUsuario.Nome">
            <div class="chat-user-info">
                <h3>@outroUsuario.Nome</h3>
                <span><i class="fa-solid fa-circle" style="font-size:0.6rem; color:#22c55e;"></i> Online para trocas</span>
            </div>
        </div>

        <div class="chat-messages" id="chatBox">
            @if (!Model.Any())
            {
                <div class="chat-empty">
                    <p style="margin: 0;">Diga olá para @outroUsuario.Nome e combine um horário!</p>
                </div>
            }
            else
            {
                @foreach (var msg in Model)
                {
                    var isMine = msg.RemetenteId == meuId;
                    var bubbleClass = isMine ? "msg-bubble mine" : "msg-bubble other";

                    <div class="@bubbleClass">
                        <div class="msg-text">@msg.Texto</div>
                        <div class="msg-time">@msg.DataEnvio.ToString("HH:mm")</div>
                    </div>
                }
            }
        </div>

        <form class="chat-input-area" action="/Chat/Enviar" method="post">
            <input type="hidden" name="DestinatarioId" value="@outroUsuario.Id" />
            <input type="text" name="Texto" placeholder="Escreva sua mensagem..." required autocomplete="off" />
            <button type="submit" class="btn-send"><i class="fa-solid fa-paper-plane"></i></button>
        </form>

    </div>
</main>

@section Scripts {
    <script>
        // Faz a rolagem descer automaticamente para a última mensagem ao carregar a página
        document.addEventListener("DOMContentLoaded", function() {
            const chatBox = document.getElementById('chatBox');
            if (chatBox) {
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        });
    </script>
}